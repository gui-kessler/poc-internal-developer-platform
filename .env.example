# Domínio base. A plataforma cria subdomínios <app>.<IDP_BASE_DOMAIN>.
# Aponte um wildcard A record (*.idp.example.com) para o IP da VPS.
IDP_BASE_DOMAIN=idp.example.com

# Token único para autenticação Bearer no POST /deploy.
# Gere um forte: openssl rand -hex 32
IDP_API_TOKEN=replace-with-strong-random-token

# Email para Let's Encrypt (avisos de expiração).
LETSENCRYPT_EMAIL=you@example.com

# Credenciais do RabbitMQ (interno, não exposto fora da rede docker).
RABBITMQ_USER=idp
RABBITMQ_PASS=changeme

# Basic auth para o dashboard do Traefik.
# Gere com: htpasswd -nbB admin yourpassword | sed -e 's/\$/\$\$/g'
TRAEFIK_DASHBOARD_USERS=admin:$$2y$$05$$replace
