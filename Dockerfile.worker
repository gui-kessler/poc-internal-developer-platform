FROM golang:1.25-alpine AS build
WORKDIR /src
COPY go.mod go.sum* ./
RUN go mod download || true
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/worker ./worker

FROM alpine:3.20
RUN apk add --no-cache docker-cli
COPY --from=build /out/worker /worker
ENTRYPOINT ["/worker"]
